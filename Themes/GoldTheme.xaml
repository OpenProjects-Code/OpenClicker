<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#080706"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#11100D"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#18150F"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#282116"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#D9A441"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0BD55"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#9A7025"/>

    <SolidColorBrush x:Key="TextBrush" Color="#FFF9EA"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7AA8C"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#4A3718"/>

</ResourceDictionary>