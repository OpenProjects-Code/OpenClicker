<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#090909"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#111111"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#181818"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#242424"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#888888"/>

    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999999"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#333333"/>

</ResourceDictionary>