<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#070A0F"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0D121A"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#101923"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#162535"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#00A8FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#19B4FF"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#006FA8"/>

    <SolidColorBrush x:Key="TextBrush" Color="#F2F7FF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8EA5B8"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#19354A"/>

</ResourceDictionary>