<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#E8EBEF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#DDE2E8"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#1479FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D91FF"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0958C7"/>

    <SolidColorBrush x:Key="TextBrush" Color="#111418"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#68717C"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#CBD1D8"/>

</ResourceDictionary>