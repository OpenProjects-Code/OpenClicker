<Window x:Class="OpenClicker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="240"
        Height="105"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Opacity="0.40">

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="15,9">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- RUNNING -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Grid Width="24"
                      Height="20"
                      Margin="0,0,7,0">

                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                        <Border.RenderTransform>

                            <TranslateTransform
                                x:Name="OverlayTransform1"/>

                        </Border.RenderTransform>

                    </Border>

                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                        <Border.RenderTransform>

                            <TranslateTransform
                                x:Name="OverlayTransform2"/>

                        </Border.RenderTransform>

                    </Border>

                </Grid>

                <TextBlock Text="Running"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>

            </StackPanel>


            <!-- CPS / LIFETIME -->
            <Border Grid.Row="1"
                    Margin="0,2,0,0"
                    Padding="7,3"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ControlBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="CPS "
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CpsText"
                               Text="10.0"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  "
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Lifetime "
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="LifetimeText"
                               Text="0"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>


            <!-- TOGGLE KEY -->
            <TextBlock Grid.Row="2"
                       x:Name="StopKeyText"
                       Text="Press F6 to stop"
                       FontSize="9"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>

        </Grid>

    </Border>

</Window>