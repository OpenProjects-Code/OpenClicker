<!-- MainWindow.xaml -->
<Window x:Class="OpenClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClicker"
        Width="430"
        MinWidth="430"
        SizeToContent="Height"
        MinHeight="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <Style x:Key="ModernButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">

            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource BackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AccentBrush}"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Height"
                    Value="48"/>

        </Style>


        <Style x:Key="ThemeMenuButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Margin"
                    Value="0,4"/>

            <Setter Property="Padding"
                    Value="14,0"/>

        </Style>


        <Style x:Key="ModernTextBox"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer
                                x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="TextBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="TextBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style TargetType="RadioButton">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Margin"
                    Value="0,0,18,0"/>

        </Style>


        <Style TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">

        <Grid>

            <Grid Height="48"
                  VerticalAlignment="Top"
                  Background="{DynamicResource PanelBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">

                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0"/>

                    <TextBlock Text="OPENCLICKER"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="—"
                            Width="42"
                            Height="48"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            FontSize="16"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"/>

                    <Button Content="×"
                            Width="42"
                            Height="48"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            FontSize="20"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>


            <Grid Margin="30,68,30,26">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel>

                    <TextBlock Text="OPENCLICKER"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Simple. Fast. Open source."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,24"/>

                </StackPanel>


                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">

                    <StackPanel>

                        <TextBlock Text="CLICK INTERVAL"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,7"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBox x:Name="IntervalBox"
                                     Text="100"
                                     Height="38"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="IntervalBox_TextChanged"
                                     LostFocus="IntervalBox_LostFocus"/>


                            <TextBlock x:Name="IntervalLabel"
                                       Grid.Column="1"
                                       Text="milliseconds"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>

                        </Grid>


                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,17,0,15"/>


                        <TextBlock Text="CLICK TYPE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,10"/>


                        <StackPanel Orientation="Horizontal">

                            <RadioButton x:Name="LeftClickRadio"
                                         Content="Left"
                                         IsChecked="True"
                                         Checked="ClickType_Checked"/>

                            <RadioButton x:Name="RightClickRadio"
                                         Content="Right"
                                         Checked="ClickType_Checked"/>

                            <RadioButton x:Name="KeyClickRadio"
                                         Content="Key"
                                         Checked="ClickType_Checked"/>

                        </StackPanel>


                        <TextBlock x:Name="ClickKeyLabel"
                                   Text="KEY TO PRESS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,18,0,8"
                                   Visibility="Collapsed"/>


                        <Button x:Name="ClickKeyButton"
                                Content="A"
                                Height="38"
                                Style="{StaticResource ModernButton}"
                                Click="ClickKeyButton_Click"
                                Visibility="Collapsed"/>


                        <TextBlock Text="ACTION"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,18,0,10"/>


                        <StackPanel Orientation="Horizontal">

                            <RadioButton x:Name="ClickActionRadio"
                                         Content="Click"
                                         IsChecked="True"
                                         Checked="ActionType_Checked"/>

                            <RadioButton x:Name="HoldActionRadio"
                                         Content="Hold"
                                         Checked="ActionType_Checked"/>

                        </StackPanel>


                        <TextBlock Text="CLICK LIMIT"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,18,0,8"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <CheckBox x:Name="ClickLimitCheckBox"
                                      Content="Stop after"
                                      VerticalAlignment="Center"
                                      Checked="ClickLimit_Changed"
                                      Unchecked="ClickLimit_Changed"/>


                            <Grid Grid.Column="1"
                                  Margin="10,0,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBox x:Name="ClickLimitBox"
                                         Text="100"
                                         Height="38"
                                         Style="{StaticResource ModernTextBox}"
                                         LostFocus="ClickLimitBox_LostFocus"/>


                                <TextBlock Grid.Column="1"
                                           Text="clicks"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Grid>


                        <TextBlock Text="TOGGLE KEY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,18,0,8"/>


                        <Button x:Name="HotkeyButton"
                                Content="F6"
                                Height="38"
                                Style="{StaticResource ModernButton}"
                                Click="HotkeyButton_Click"/>


                        <Button x:Name="StartButton"
                                Content="START"
                                Margin="0,20,0,8"
                                Style="{StaticResource AccentButton}"
                                Click="StartButton_Click"/>


                        <Grid Height="24"
                              HorizontalAlignment="Center">


                            <StackPanel x:Name="StoppedStatus"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Border Width="7"
                                        Height="7"
                                        CornerRadius="4"
                                        Background="{DynamicResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"/>

                                <TextBlock Text="Stopped"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"/>

                            </StackPanel>


                            <StackPanel x:Name="RunningStatus"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">

                                <Grid Width="19"
                                      Height="16"
                                      VerticalAlignment="Center">

                                    <Border Width="7"
                                            Height="7"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">

                                        <Border.RenderTransform>

                                            <TranslateTransform
                                                x:Name="RunningTransform1"/>

                                        </Border.RenderTransform>

                                    </Border>


                                    <Border Width="7"
                                            Height="7"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                        <Border.RenderTransform>

                                            <TranslateTransform
                                                x:Name="RunningTransform2"/>

                                        </Border.RenderTransform>

                                    </Border>

                                </Grid>


                                <TextBlock Text="Running"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"/>

                            </StackPanel>

                        </Grid>


                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">

                            <TextBlock Text="CPS "
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="ProjectedCpsText"
                                       Text="10.0"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="  •  Lifetime "
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="LifetimeClicksText"
                                       Text="0"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <Grid Grid.Row="2"
                      Margin="0,12,0,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="OPENCLICKER"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <CheckBox x:Name="OverlayCheckBox"
                                  Content="Overlay"
                                  Margin="18,0,0,0"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"
                                  Checked="OverlayCheckBox_Changed"
                                  Unchecked="OverlayCheckBox_Changed"/>

                    </StackPanel>


                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="PresetButton"
                                Content="PRESETS"
                                Width="82"
                                Height="28"
                                Margin="0,0,0,4"
                                Style="{StaticResource ModernButton}"
                                Click="PresetButton_Click"/>

                        <Button x:Name="ThemeButton"
                                Content="THEMES"
                                Width="82"
                                Height="28"
                                Style="{StaticResource ModernButton}"
                                Click="ThemeButton_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>


            <Button x:Name="ThemeBackdrop"
                    Visibility="Collapsed"
                    Background="#66000000"
                    BorderThickness="0"
                    Click="ThemeBackdrop_Click"/>


            <Border x:Name="ThemePanel"
                    Width="230"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="16,0,0,16"
                    ClipToBounds="True">

                <Border.RenderTransform>

                    <TranslateTransform
                        x:Name="ThemePanelTransform"
                        X="230"/>

                </Border.RenderTransform>


                <Grid Margin="18">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <StackPanel>

                        <TextBlock Text="Themes"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Choose your style"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,18"/>

                    </StackPanel>


                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="ThemeListPanel"/>

                    </ScrollViewer>


                    <Button Grid.Row="2"
                            Content="CLOSE"
                            Height="38"
                            Margin="0,16,0,0"
                            Style="{StaticResource ModernButton}"
                            Click="ThemeBackdrop_Click"/>

                </Grid>

            </Border>


            <Button x:Name="PresetBackdrop"
                    Visibility="Collapsed"
                    Background="#66000000"
                    BorderThickness="0"
                    Click="PresetBackdrop_Click"/>


            <Border x:Name="PresetPanel"
                    Width="270"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="16,0,0,16"
                    ClipToBounds="True">

                <Border.RenderTransform>

                    <TranslateTransform
                        x:Name="PresetPanelTransform"
                        X="270"/>

                </Border.RenderTransform>


                <Grid Margin="18">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <StackPanel>

                        <TextBlock Text="Presets"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Save and load your setups"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,16"/>

                    </StackPanel>


                    <StackPanel Grid.Row="1">

                        <TextBox x:Name="PresetNameBox"
                                 Height="38"
                                 Style="{StaticResource ModernTextBox}"
                                 ToolTip="Preset name"/>

                        <Button Content="SAVE CURRENT"
                                Height="38"
                                Margin="0,8,0,12"
                                Style="{StaticResource AccentButton}"
                                Click="SavePresetButton_Click"/>

                    </StackPanel>


                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="PresetListPanel"/>

                    </ScrollViewer>


                    <Button Grid.Row="3"
                            Content="CLOSE"
                            Height="38"
                            Margin="0,16,0,0"
                            Style="{StaticResource ModernButton}"
                            Click="PresetBackdrop_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>